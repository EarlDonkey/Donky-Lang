import "lib/world.donk";

print("Step 1: world_new");
let world = world_new(128, 128, 42);
print("Step 2: world allocated, ptr=" + str(world["ptr"]));

print("Step 3: calling world_gen");
let r = world_gen(world["ptr"], world["width"], world["height"], world["seed"], 0, 0);
print("Step 4: world_gen returned " + str(r));

print("Step 5: reading one block");
let b = world_block(world, 64, 64);
print("Step 6: block at (64,64) = " + str(b));

print("Step 7: counting");
let counts = {};
let y = 0;
while y < 128 {
    let x = 0;
    while x < 128 {
        let bb = world_block(world, x, y);
        if counts[bb] == null { counts[bb] = 0; }
        counts[bb] = counts[bb] + 1;
        x = x + 1;
    }
    y = y + 1;
}

print("Step 8: count complete");
print("  air: " + str(counts[0]));
print("  stone: " + str(counts[2]));