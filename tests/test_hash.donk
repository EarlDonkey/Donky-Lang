import "lib/hash.donk";

fn check(ok, name) {
    if ok { sys_puts("  ok    " + name); }
    else { sys_puts("  FAIL  " + name); global_set("fails", global_get("fails") + 1); }
    return 0;
}
fn finish(label) {
    let f = global_get("fails");
    if f > 0 { sys_puts(label + ": " + str(f) + " FAILED"); sys_exit(1); }
    sys_puts(label + ": all passed");
    return 0;
}

check(md5("") == "d41d8cd98f00b204e9800998ecf8427e", "md5 empty");
check(md5("abc") == "900150983cd24fb0d6963f7d28e17f72", "md5 abc");
check(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 abc");
check(sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709", "sha1 empty");
check(sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 empty");
check(sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 abc");
check(hmac_sha256("key", "The quick brown fox jumps over the lazy dog") == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8", "hmac_sha256");

// block-boundary lengths (55/56/64 bytes) exercise the padding logic
let a55 = repeat55();
check(len(sha256(a55)) == 64 && len(md5(a55)) == 32 && len(sha1(a55)) == 40, "digest lengths at 55 bytes");
check(sha256([97, 98, 99]) == sha256("abc"), "byte array input == string input");

check(bytes_to_hex([0, 15, 255]) == "000fff", "bytes_to_hex");
check(json_encode(hex_to_bytes("000fFF")) == "[0,15,255]", "hex_to_bytes");

fn repeat55() {
    let out = [];
    let i = 0;
    while i < 55 { push(out, 97); i = i + 1; }
    return bytes_to_str(out);
}

finish("test_hash");