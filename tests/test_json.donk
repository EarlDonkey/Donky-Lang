import "lib/json.donk";

fn main() {
    let json_str = "{\"name\": \"Buddy\", \"age\": 3, \"good_boy\": true, \"skills\": [\"sit\", \"stay\"]}";
    
    let dog = json_parse(json_str);
    
    print("Name: " + dog["name"]);
    print("Age: " + str(dog["age"]));
    print("Good boy: " + str(dog["good_boy"]));
    print("First skill: " + dog["skills"][0]);
}

main();