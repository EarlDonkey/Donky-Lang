print("Parent: starting");

let pid = fork();

if pid == 0 {
    // Child process
    print("Child: executing 'ping'");
    // exec(path, argv). The argv array MUST include the program name as the first element.
    exec("cmd.exe", ["cmd.exe", "/c", "echo Hello from the child process > output.txt"]);
    // If exec succeeds, it never returns. If it fails, it throws an error.
    print("Child: exec failed");
    sys_exit(1);
} else {
    // Parent process
    print("Parent: forked child with PID " + str(pid));
    
    // Wait for the child to finish
    let status = wait(pid);
    print("Parent: child exited with status " + str(status));
    
    // Read the file the child created
    let result = read_file("output.txt");
    print("Parent: read file contents: " + result);
}