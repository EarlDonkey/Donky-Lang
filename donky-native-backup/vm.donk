// vm.donk — Self-Hosted Donky Virtual Machine

fn eval_op(op, a, b) {
    if op == "Plus" { return a + b; }
    if op == "Minus" { return a - b; }
    if op == "Star" { return a * b; }
    if op == "Slash" { return a / b; }
    if op == "EqEq" { return a == b; }
    if op == "NotEq" { return a != b; }
    if op == "Lt" { return a < b; }
    if op == "Gt" { return a > b; }
    if op == "LtEq" { return a <= b; }
    if op == "GtEq" { return a >= b; }
    throw "Unknown operator: " + op;
}

fn eval_cmp(op, a, b) {
    if op == "Lt" { return a < b; }
    if op == "LtEq" { return a <= b; }
    if op == "Gt" { return a > b; }
    if op == "GtEq" { return a >= b; }
    if op == "EqEq" { return a == b; }
    if op == "NotEq" { return a != b; }
    throw "Unknown comparison: " + op;
}

fn call_builtin(name, args) {
    if name == "len" { return len(args[0]); }
    if name == "push" { push(args[0], args[1]); return null; }
    if name == "pop" { return pop(args[0]); }
    if name == "split" { return split(args[0], args[1]); }
    if name == "join" { return join(args[0], args[1]); }
    if name == "num" { return num(args[0]); }
    if name == "str" { return str(args[0]); }
    if name == "read_file" { return read_file(args[0]); }
    if name == "write_file" { write_file(args[0], args[1]); return null; }
    if name == "byte_at" { return byte_at(args[0], args[1]); }
    if name == "byte_substr" { return byte_substr(args[0], args[1], args[2]); }
    if name == "bytes_to_str" { return bytes_to_str(args[0]); }
    if name == "type" { return type(args[0]); }
    if name == "contains" { return contains(args[0], args[1]); }
    if name == "is_null" { return args[0] == null; }
    if name == "is_dir" { return is_dir(args[0]); }
    if name == "now" { return now(); }
    throw "Unknown builtin: " + name;
}

fn run_bytecode(bytecode, script_args) {
    _run_bytecode_impl(bytecode, script_args, null, 100000000);
}

fn run_bytecode_capture(bytecode, script_args) -> string {
    let sink = [];
    _run_bytecode_impl(bytecode, script_args, sink, 5000000);
    return join(sink, "\n");
}

fn _run_bytecode_impl(bytecode, script_args, output_sink, max_steps) {
    let stack = [];
    let locals = {};
    let globals = {};
    let call_stack = [];
    let steps = 0;

    globals["args"] = script_args;

    let decoded = [];
    for instruction in bytecode {
        let op = "";
        let arg = "";
        let space_idx = -1;
        let i = 0;
        while i < len(instruction) {
            if byte_at(instruction, i) == 32 { 
                space_idx = i; 
                break; 
            }
            i = i + 1;
        }
        
        if space_idx == -1 {
            op = instruction;
        } else {
            op = byte_substr(instruction, 0, space_idx);
            arg = byte_substr(instruction, space_idx + 1, len(instruction));
        }
        push(decoded, [op, arg]);
    }

    let ip = 0;
    let len_bc = len(decoded);

    while ip < len_bc {
        steps = steps + 1;
        if steps > max_steps {
            throw "Execution limit exceeded (" + str(max_steps) + " steps) — possible infinite loop";
        }

        let pair = decoded[ip];
        let op = pair[0];
        let arg = pair[1];

        if op == "PushNumber" { push(stack, num(arg)); }
        else if op == "PushString" { 
            let v = arg;
            if len(v) >= 2 && byte_at(v, 0) == 34 && byte_at(v, len(v) - 1) == 34 {
                v = byte_substr(v, 1, len(v) - 1);
            }
            push(stack, v); 
        }
        else if op == "PushBool" { push(stack, arg == "true"); }
        else if op == "PushNull" { push(stack, null); }
        else if op == "Pop" { pop(stack); }
        else if op == "SetLocal" { locals[arg] = pop(stack); }
        else if op == "GetLocal" {
            if contains(locals, arg) { push(stack, locals[arg]); }
            else if contains(globals, arg) { push(stack, globals[arg]); }
            else { throw "Undefined variable: " + arg; }
        }
        else if op == "BinOp" {
            let b = pop(stack);
            let a = pop(stack);
            push(stack, eval_op(arg, a, b));
        }
        else if op == "PushLocalAddConst" {
            let raw = split(arg, " ");
            push(stack, locals[raw[0]] + num(raw[1]));
        }
        else if op == "PushLocalSubConst" {
            let raw = split(arg, " ");
            push(stack, locals[raw[0]] - num(raw[1]));
        }
        else if op == "UnaryOp" {
            let val = pop(stack);
            if arg == "Minus" { push(stack, -val); }
            else if arg == "Bang" { push(stack, !val); }
        }
        else if op == "BinLocals" {
            let raw = split(arg, " ");
            push(stack, eval_op(raw[0], locals[raw[1]], locals[raw[2]]));
        }
        else if op == "IncLocal" {
            let raw = split(arg, " ");
            locals[raw[0]] = locals[raw[0]] + num(raw[1]);
        }
        else if op == "AddLocalConst" {
            let raw = split(arg, " ");
            locals[raw[2]] = locals[raw[0]] + num(raw[1]);
        }
        else if op == "AddLocalMulLocal" {
            let raw = split(arg, " ");
            locals[raw[0]] = locals[raw[0]] + locals[raw[1]] * locals[raw[2]];
        }
        else if op == "IncLocalJump" {
            let raw = split(arg, " ");
            locals[raw[0]] = locals[raw[0]] + num(raw[1]);
            ip = num(raw[2]);
            continue;
        }
        else if op == "JumpIfLocalCmpFalse" {
            let raw = split(arg, " ");
            if !eval_cmp(raw[0], locals[raw[1]], locals[raw[2]]) {
                ip = num(raw[3]);
                continue;
            }
        }
        else if op == "JumpIfLocalConstCmpFalse" {
            let raw = split(arg, " ");
            if !eval_cmp(raw[0], locals[raw[1]], num(raw[2])) {
                ip = num(raw[3]);
                continue;
            }
        }
        else if op == "Print" {
            let v = pop(stack);
            if output_sink == null {
                print(v);
            } else {
                push(output_sink, str(v));
            }
        }
        else if op == "Jump" { ip = num(arg); continue; }
        else if op == "JumpIfFalse" {
            let cond = pop(stack);
            if !cond { ip = num(arg); continue; }
        }
        else if op == "DefineFunction" {
            // arg is "add 28 a,b"
            let raw = split(arg, " ");
            let name = raw[0];
            let addr = num(raw[1]);
            let param_str = "";
            if len(raw) > 2 { param_str = raw[2]; }
            
            globals[name] = addr;
            
            let params_arr = [];
            if len(param_str) > 0 {
                params_arr = split(param_str, ",");
            }
            globals[name + "_params"] = params_arr;
        }
        else if op == "Call" {
            let raw = split(arg, " ");
            let func_name = raw[0];
            let arg_count = num(raw[1]);

            if func_name == "boot" {
                print("DBG CALL BOOT: globals has boot? " + str(contains(globals, "boot")));
            }
            
            if !contains(globals, func_name) {
                let args = [];
                let i = 0;
                while i < arg_count { push(args, pop(stack)); i = i + 1; }
                let real_args = [];
                let j = len(args) - 1;
                while j >= 0 { push(real_args, args[j]); j = j - 1; }
                let res = call_builtin(func_name, real_args);
                push(stack, res);
            } else {
                let func_addr = globals[func_name];
                
                // Pop arguments
                let args = [];
                let i = 0;
                while i < arg_count { push(args, pop(stack)); i = i + 1; }
                
                // Reverse them to correct order
                let real_args = [];
                let j = len(args) - 1;
                while j >= 0 { push(real_args, args[j]); j = j - 1; }
                
                push(call_stack, { "ip": ip + 1, "locals": locals });
                
                // Setup new locals
                locals = {};
                let p_names = globals[func_name + "_params"];
                let k = 0;
                while k < len(p_names) && k < len(real_args) {
                    locals[p_names[k]] = real_args[k];
                    k = k + 1;
                }
                
                ip = func_addr;
                continue;
            }
        }
        else if op == "Return" {
            let ret_val = pop(stack);
            if len(call_stack) > 0 {
                let frame = pop(call_stack);
                ip = frame["ip"];
                locals = frame["locals"];
                push(stack, ret_val);
            } else { break; }
            continue;
        }
        else if op == "MakeArray" {
            let count = num(arg);
            let arr = [];
            let i = 0;
            while i < count { push(arr, pop(stack)); i = i + 1; }
            let final_arr = [];
            let j = len(arr) - 1;
            while j >= 0 { push(final_arr, arr[j]); j = j - 1; }
            push(stack, final_arr);
        }
        else if op == "MakeMap" {
            let count = num(arg);
            let map = {};
            let i = 0;
            while i < count {
                let val = pop(stack);
                let key = pop(stack);
                map[key] = val;
                i = i + 1;
            }
            push(stack, map);
        }
        else if op == "Index" {
            let idx = pop(stack);
            let target = pop(stack);
            push(stack, target[idx]);
        }
        else if op == "IndexSet" {
            let val = pop(stack);
            let idx = pop(stack);
            let target = pop(stack);
            target[idx] = val;
        }
        else if op == "Throw" {
            let val = pop(stack);
            if output_sink == null {
                throw "Exception: " + str(val);
            } else {
                push(output_sink, "Exception: " + str(val));
                return;
            }
        }
        else if op == "Halt" { break; }

        ip = ip + 1;
    }
}