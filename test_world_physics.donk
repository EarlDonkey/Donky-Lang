import "lib/world.donk";

let W = 10;
let H = 10;
let world = world_new(W, H, 42);

// Fill with air.
let x = 0;
while x < W {
    let y = 0;
    while y < H {
        world_set_block(world, x, y, 0);
        y = y + 1;
    }
    x = x + 1;
}

// Drop sand at (5, 0).
world_set_block(world, 5, 0, 5);

// Tick 10 times.
let i = 0;
while i < 10 {
    world_tick(world);
    i = i + 1;
}

// Find sand.
let sx = -1;
let sy = -1;
x = 0;
while x < W {
    let y = 0;
    while y < H {
        if world_block(world, x, y) == 5 { sx = x; sy = y; }
        y = y + 1;
    }
    x = x + 1;
}

print("Sand ended up at (" + str(sx) + ", " + str(sy) + ")");
if sx != 5 { throw "sand moved sideways"; }
if sy < 5 { throw "sand did not fall"; }
print("PASS: sand fell straight down");