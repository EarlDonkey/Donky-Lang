// Move the function OUTSIDE of main
fn increment(state) {
    state[0] = state[0] + 1;
    return true;
}

fn main() {
    let arr = [1, 2, 3];
    let i = 5;
    
    // Test 1: Short-circuit (&&)
    if i < len(arr) && arr[i] == 3 {
        print("FAIL: Out of bounds crash avoided, but logic is wrong.");
    } else {
        print("PASS: Short-circuit worked! (No crash)");
    }

    // Test 2: Short-circuit (||)
    let state = [0]; // Use an array to pass the counter by reference
    let result = true || increment(state);
    
    if state[0] == 0 {
        print("PASS: || short-circuited (increment didn't run)");
    } else {
        print("FAIL: || did not short-circuit");
    }
}
main();