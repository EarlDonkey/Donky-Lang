// examples/sentinel/sentinel.donk — HTTP server for Sentinel.
//
// Reference: server.donk at repo root (tcp_listen/tcp_accept/tcp_read/
// tcp_write + spawn per connection). Port 8082 (8080/8081 are taken by the
// demo).
//
// STATIC CACHE: index.html is read once at top level. The top-level `let
// HTML_CACHE` is written via donky_global_set by the AOT (SEMANTICS §11.3 /
// aot.rs's top-level Let handling); handle_client reads it via
// global_get("HTML_CACHE"). This is the documented escape hatch for top-level
// `let` visibility inside functions.
//
// If index.html is missing, we serve a short placeholder so the server still
// starts (and the collector still runs). The error is printed once at
// startup, not per request.

// ---------------------------------------------------------------------------
// read_request(client) -> string. Reads until "\r\n\r\n" or peer close.
// tcp_read on a closed socket returns "" (SEMANTICS §6 / runtime tcp_read),
// so an empty first read means the client is already gone.
// ---------------------------------------------------------------------------
fn read_request(client) {
    let buf = "";
    while len(buf) < 8192 {
        let chunk = tcp_read(client, 4096);
        if len(chunk) == 0 {
            return "";   // connection closed before any data
        }
        buf = buf + chunk;
        if contains(buf, "\r\n\r\n") {
            return buf;
        }
    }
    return buf;
}

// ---------------------------------------------------------------------------
// request_path(raw) -> "/..." or "/". Pulls parts[1] out of
// "GET /path HTTP/1.1\r\n...". Uses `split(raw, "\r\n")` — split's delimiter
// is a SET of characters (SEMANTICS §4.1); "\r" and "\n" are both whitespace
// boundaries for us, which is what we want here.
// ---------------------------------------------------------------------------
fn request_path(raw) {
    let lines = split(raw, "\r\n");
    if len(lines) == 0 { return "/"; }
    let parts = split(lines[0], " ");
    if len(parts) < 2 { return "/"; }
    return parts[1];
}

// ---------------------------------------------------------------------------
// POST /api/kill helpers.
//   request_method(raw)      -> "GET" / "POST" / ... ("" if unparseable).
//   header_value(raw, name)  -> first token of that header's value, or null. `name` is
//                               lower-case with the colon, e.g. "origin:". Header names have no
//                               spaces, so splitting each line on " " is enough.
//   request_body(raw)        -> text after the blank line, IF it arrived in the same read as the
//                               headers. split() drops empty tokens, so the body is the last
//                               token, and the only one without a ':' (every header has one).
//   read_kill_body(conn, raw)-> the body, reading once more if it came in its own TCP segment
//                               (some clients send headers and body separately). It only reads
//                               when Content-Length promises bytes, so it cannot block on a
//                               request that has no body.
//   origin_refused(raw)      -> true for a browser request from any page other than Sentinel's
//                               own (blocks drive-by POSTs from other websites). Requests with no
//                               Origin header (curl, scripts) pass. Port must match serve().
//   is_pid_text(s)           -> true for 1-10 ASCII digits.
// ---------------------------------------------------------------------------
fn request_method(raw) {
    let lines = split(raw, "\r\n");
    if len(lines) == 0 { return ""; }
    let parts = split(lines[0], " ");
    if len(parts) == 0 { return ""; }
    return parts[0];
}

fn header_value(raw, name) {
    let lines = split(raw, "\r\n");
    let i = 1;
    while i < len(lines) {
        let parts = split(lines[i], " ");
        if len(parts) >= 2 {
            if lower(parts[0]) == name { return parts[1]; }
        }
        i = i + 1;
    }
    return null;
}

fn request_body(raw) {
    let lines = split(raw, "\r\n");
    let n = len(lines);
    if n < 2 { return ""; }
    let last = lines[n - 1];
    if contains(last, ":") { return ""; }
    return last;
}

fn read_kill_body(conn_id, raw) {
    let cl = header_value(raw, "content-length:");
    if cl == null { return ""; }
    let want = num(cl);
    if want < 1 || want > 32 { return ""; }
    let body = request_body(raw);
    if len(body) < want {
        body = body + tcp_read(conn_id, 64);
    }
    return body;
}

fn origin_refused(raw) {
    let o = header_value(raw, "origin:");
    if o == null { return false; }
    let v = lower(o);
    if v == "http://localhost:8082" { return false; }
    if v == "http://127.0.0.1:8082" { return false; }
    return true;
}

fn is_pid_text(s) {
    let n = len(s);
    if n < 1 || n > 10 { return false; }
    let i = 0;
    while i < n {
        if contains("0123456789", substr(s, i, i + 1)) {
            i = i + 1;
        } else {
            return false;
        }
    }
    return true;
}

// ---------------------------------------------------------------------------
// respond(client, status_line, mime, body) -> null. One write, one close.
// ---------------------------------------------------------------------------
fn respond(client, status_line, mime, body) {
    let resp = "HTTP/1.1 " + status_line + "\r\n"
             + "Content-Type: " + mime + "\r\n"
             + "Content-Length: " + str(len(body)) + "\r\n"
             + "Cache-Control: no-store\r\n"
             + "Access-Control-Allow-Origin: *\r\n"
             + "Connection: close\r\n"
             + "\r\n"
             + body;
    tcp_write(client, resp);
    tcp_close(client);
    return null;
}

// ---------------------------------------------------------------------------
// handle_client(conn_id) -> null. Top-level fn so spawn can call it
// (SEMANTICS §11.5: spawn takes (func_ptr, arg), no closure capture).
// ---------------------------------------------------------------------------
fn handle_client(conn_id) {
    let raw = read_request(conn_id);
    if len(raw) == 0 {
        // Client connected and immediately closed, or tcp_accept returned a
        // dead id. Nothing to do.
        tcp_close(conn_id);
        return null;
    }
    let path = request_path(raw);

    if path == "/" || path == "/index.html" {
        let html = read_file("examples/sentinel/index.html");
        if html == null {
            html = "<!doctype html><title>Sentinel</title><p>index.html not found.</p>";
        }
        respond(conn_id, "200 OK", "text/html; charset=utf-8", html);
        return null;
    }

    if path == "/api/snapshot" {
        let buf = global_get("sentinel_buffer");
        if buf == null { buf = []; }
        respond(conn_id, "200 OK", "application/json", json_encode(buf));
        return null;
    }

    if path == "/api/latest" {
        let buf = global_get("sentinel_buffer");
        if buf == null || len(buf) == 0 {
            respond(conn_id, "200 OK", "application/json", "null");
            return null;
        }
        let latest = buf[len(buf) - 1];
        respond(conn_id, "200 OK", "application/json", json_encode(latest));
        return null;
    }

    if path == "/api/software" {
        respond(conn_id, "200 OK", "application/json", json_encode(global_get("sentinel_software")));
        return null;
    }

    if path == "/api/kill" {
        if request_method(raw) != "POST" {
            respond(conn_id, "405 Method Not Allowed", "text/plain; charset=utf-8", "use POST");
            return null;
        }
        if origin_refused(raw) {
            respond(conn_id, "403 Forbidden", "text/plain; charset=utf-8", "cross-origin request refused");
            return null;
        }
        // Body is the PID as text, e.g. 1234. num() is atof-based and never fails ("abc" -> 0,
        // "12abc" -> 12), so the text is validated as digits before it is parsed.
        let toks = split(read_kill_body(conn_id, raw), " \r\n");
        let text = "";
        if len(toks) == 1 { text = toks[0]; }
        if is_pid_text(text) {
            let pid = num(text);
            if pid < 1 || pid > 4294967295 {
                respond(conn_id, "400 Bad Request", "text/plain; charset=utf-8", "bad pid");
                return null;
            }
            if kill_proc(pid) {
                respond(conn_id, "200 OK", "text/plain; charset=utf-8", "ok");
            } else {
                respond(conn_id, "500 Internal Server Error", "text/plain; charset=utf-8", "kill failed");
            }
            return null;
        }
        respond(conn_id, "400 Bad Request", "text/plain; charset=utf-8", "bad pid");
        return null;
    }

    // Unknown route.
    let body = "not found: " + path;    respond(conn_id, "404 Not Found", "text/plain; charset=utf-8", body);
    return null;
}

// ---------------------------------------------------------------------------
// setup_server() -> server handle (int) or null. Binds 8082 and returns the
// listening socket. Split out of the old serve() so that run.donk can bind
// *before* handing off to a spawned accept loop (and so gui_webview has a
// live port to point at on the main thread). Does NOT block.
// ---------------------------------------------------------------------------
fn setup_server() {
    let port = 8082;
    let server = tcp_listen(port);
    if server == null || server < 0 {
        print("sentinel: tcp_listen(" + str(port) + ") failed");
        return null;
    }
    print("sentinel: listening on http://localhost:" + str(port) + "/");
    return server;
}

// ---------------------------------------------------------------------------
// start_server(server_handle) -> null (never returns). Accept loop. Intended
// to be run on a spawn worker (SEMANTICS §11.5), not the main thread — the
// main thread blocks in gui_webview().
//
// If server_handle is null/invalid (setup_server failed), sleep briefly and
// return so we don't hot-spin a bad accept. run.donk will already have
// printed the bind failure.
// ---------------------------------------------------------------------------
fn start_server(server_handle) {
    if server_handle == null || server_handle < 0 {
        print("sentinel: start_server called with invalid handle");
        return null;
    }
    while true {
        let conn = tcp_accept(server_handle);
        if conn == null || conn < 0 {
            // Accept failed (rare). Avoid a hot spin.
            sleep(50);
        } else {
            spawn(handle_client, conn);
        }
    }
    return null;
}