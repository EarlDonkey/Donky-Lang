// Allocate 1 page (4096 bytes) of executable memory
let p = mem_alloc(4096);

if p == 0 {
    print("Failed to allocate memory");
    sys_exit(1);
}

// The machine code for: mov eax, 42; ret
// (x86-64 architecture)
let code = [0xB8, 0x2A, 0x00, 0x00, 0x00, 0xC3];

// Write the code to memory
mem_write(p, code);

// Change protection to Read + Execute (prot = 2)
let success = mem_protect(p, 4096, 2);
if success == 0.0 {
    print("Failed to set memory to executable");
    sys_exit(1);
}

// Call the machine code as a function!
let result = dll_call_sig(p, "i", "", []);

print("JIT returned: " + str(result));

// Clean up
mem_free(p, 4096);