// tests/test_agents.donk
// Creates a 32x32 world, spawns 50 agents on the surface,
// ticks 200 times, and checks survival + bounds + movement.

import "lib/world.donk";

let W = 32;
let H = 32;
let N = 50;

print("test_agents: building " + str(W) + "x" + str(H) + " world (seed 42)");

let world = world_new(W, H, 42);
world_generate(world);
agents_init(world, N);

// ---- place agents on the surface, top of each column ----
// For each agent i, scan column x = i % W from top (y = 0) down until
// the first non-air block; place the agent one cell above it. If the
// column is all air, place at y = 0.
fn top_solid_y(world, x) {
    let y = 0;
    while y < world["height"] {
        let b = world_block(world, x, y);
        if b != 0 { return y; }   // 0 = BLK_AIR
        y = y + 1;
    }
    return 0;
}

let i = 0;
let starts = [];      // record starting (x, y) for the movement check
while i < N {
    let x = i % W;
    let y = top_solid_y(world, x);
    // write x and y into the agent buffer at offsets 0 and 4 (int32 LE via ffi_poke 4-byte)
    ffi_poke(world["agents_ptr"] + i * 40 + 0, 4, x);
    ffi_poke(world["agents_ptr"] + i * 40 + 4, 4, y);
    push(starts, [x, y]);
    i = i + 1;
}

// ---- tick 200 times ----
print("test_agents: ticking 200");
let t = 0;
while t < 200 {
    world_tick(world);
    t = t + 1;
}

// ---- assert alive count >= 45 ----
let alive = agents_alive(world);
if alive < 45 {
    throw "test_agents: expected >= 45 alive, got " + str(alive);
}

// ---- assert every agent in bounds ----
i = 0;
while i < N {
    let x = agent_x(world, i);
    let y = agent_y(world, i);
    if x < 0 || x >= W || y < 0 || y >= H {
        throw "test_agents: agent " + str(i) + " out of bounds at (" +
              str(x) + "," + str(y) + ")";
    }
    i = i + 1;
}

// ---- assert at least one agent moved ----
let moved = 0;
i = 0;
while i < N {
    let sx = starts[i][0];
    let sy = starts[i][1];
    if agent_x(world, i) != sx || agent_y(world, i) != sy { moved = moved + 1; }
    i = i + 1;
}
if moved < 1 {
    throw "test_agents: no agent moved after 200 ticks (starts unchanged)";
}

print("PASS: " + str(N) + " agents spawned, 200 ticks, " + str(alive) +
      " alive, " + str(moved) + " moved, all in bounds");