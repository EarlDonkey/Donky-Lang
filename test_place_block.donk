// tests/test_place_block.donk
// World set_block / block read-back. No ticks between set and read:
// if you tick, water moves and this assertion lies.

import "lib/world.donk";

let W = 16;
let H = 16;

print("test_place_block: building " + str(W) + "x" + str(H) + " world");

let world = world_new(W, H, 42);
world_generate(world);

// Set stone at (8, 8).
let rc = world_set_block(world, 8, 8, 2);
if rc != 1 {
    throw "test_place_block: world_set_block(8,8,2) returned " + str(rc) + ", expected 1";
}
let b1 = world_block(world, 8, 8);
if b1 != 2 {
    throw "test_place_block: world_block(8,8) after stone = " + str(b1) + ", expected 2";
}

// Replace with water at (8, 8). No tick between set and read.
let rc2 = world_set_block(world, 8, 8, 4);
if rc2 != 1 {
    throw "test_place_block: world_set_block(8,8,4) returned " + str(rc2) + ", expected 1";
}
let b2 = world_block(world, 8, 8);
if b2 != 4 {
    throw "test_place_block: world_block(8,8) after water = " + str(b2) + ", expected 4";
}

print("PASS: block placement verified (stone -> water at 8,8)");