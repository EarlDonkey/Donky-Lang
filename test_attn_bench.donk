import "lib/llm.donk";

print("Loading model...");
let model = llm_load("model.gguf");
let ids = tok_chat_prompt(model, "Hello");
print("Prompt length: " + str(len(ids)));
print("CPU cores: " + str(cpu_cores()));
print("Wall clock: " + str(now()));

// --- 1. Correctness: cached path vs uncached path ---
print("\n--- correctness ---");
let diff = llm_kv_selfcheck(model, ids);
print("max |cached - uncached| logit: " + str(diff));
if diff < 0.001 {
    print("PASS (difference is below 1e-3, expected with AVX2 float accumulation)");
} else {
    print("FAIL (difference too large)");
}

// --- 2. Forward pass (baseline) ---
print("\n--- timing: llm_forward (uncached, 11 tokens) ---");
let t0 = now_ms();
let _ = llm_forward(model, ids);
let t1 = now_ms();
let fwd_ms = t1 - t0;
print("  " + str(fwd_ms) + " ms");

// --- 3. Attention kernel only (the new C function) ---
print("\n--- timing: tensor_attention_decode (per layer, 11 tokens) ---");
// Build a fake KV cache state with 11 positions for one layer.
let q_len = model["n_heads"] * model["d_head"];
let kv_dim = model["n_heads_kv"] * model["d_head"];
let q_test = [];
let kc_test = [];
let v_test = [];
let i = 0;
while i < q_len {
    push(q_test, 0.01 * i);
    i = i + 1;
}
i = 0;
while i < 11 * kv_dim {
    push(kc_test, 0.001 * i);
    push(v_test, 0.002 * i);
    i = i + 1;
}
let attn_t0 = now_ms();
let _ = tensor_attention_decode(q_test, kc_test, v_test, 11, model["n_heads"], model["n_heads_kv"], model["d_head"]);
let attn_t1 = now_ms();
print("  " + str(attn_t1 - attn_t0) + " ms per layer");
print("  ~" + str((attn_t1 - attn_t0) * model["n_layers"]) + " ms for all " + str(model["n_layers"]) + " layers");

// --- 4. Cached generation (should now be much faster) ---
print("\n--- timing: llm_generate_cached (10 tokens) ---");
let gen_c_t0 = now_ms();
let _ = llm_generate_cached(model, ids, 10, 0.6, 40);
let gen_c_t1 = now_ms();
let gen_c_ms = gen_c_t1 - gen_c_t0;
print("  " + str(gen_c_ms) + " ms for 10 tokens (" + str(gen_c_ms / 10.0) + " ms per token)");

// --- 5. Uncached generation (baseline, for comparison) ---
print("\n--- timing: llm_generate (10 tokens, uncached) ---");
let gen_u_t0 = now_ms();
let _ = llm_generate(model, ids, 10, 0.6, 40);
let gen_u_t1 = now_ms();
let gen_u_ms = gen_u_t1 - gen_u_t0;
print("  " + str(gen_u_ms) + " ms for 10 tokens (" + str(gen_u_ms / 10.0) + " ms per token)");

// --- 6. Summary ---
print("\n=== summary ===");
print("forward pass (11 tokens):   " + str(fwd_ms) + " ms");
print("cached generation (10 tok): " + str(gen_c_ms) + " ms");
print("uncached generation (10):   " + str(gen_u_ms) + " ms");
print("KV cache speedup:           " + str(gen_u_ms / gen_c_ms) + "x");
print("Wall clock end: " + str(now()));