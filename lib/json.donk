// lib/json.donk — thin wrapper over the native C parser/encoder.
// Builtins: json_decode(str), json_encode(v), json_pretty(v), json_error()

fn json_parse(s) {
    let v = json_decode(s);
    let e = json_error();
    if len(e) > 0 { throw e; }
    return v;
}

fn json_stringify(v) {
    let r = json_encode(v);
    let e = json_error();
    if len(e) > 0 { throw e; }
    return r;
}