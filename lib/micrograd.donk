// let b = value_make(3.0);
// let c = value_add(value_mul(a, b), value_make(4.0));
// value_backward(c);
// // c[0] = 10.0, c[1] = 1.0
// // a[1] = 3.0  (b[0])
// // b[1] = 2.0  (a[0])