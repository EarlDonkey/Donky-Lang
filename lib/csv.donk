// lib/csv.donk — RFC 4180 style. Fields are always returned as strings.

fn csv_parse_delim(text, delim) {
    let rows = [];
    let n = len(text);
    let i = 0;
    while i < n {
        let row = [];
        let row_done = false;
        while !row_done {
            let field = "";
            if byte_at(text, i) == 34 {
                // quoted field
                let parts = [];
                i = i + 1;
                let seg = i;
                while i < n {
                    if byte_at(text, i) == 34 {
                        if byte_at(text, i + 1) == 34 {
                            push(parts, byte_substr(text, seg, i + 1));
                            i = i + 2;
                            seg = i;
                        } else {
                            break;
                        }
                    } else {
                        i = i + 1;
                    }
                }
                push(parts, byte_substr(text, seg, i));
                if i < n { i = i + 1; }
                field = join(parts, "");
            } else {
                let start = i;
                while i < n {
                    let c = byte_at(text, i);
                    if c == delim || c == 10 || c == 13 { break; }
                    i = i + 1;
                }
                field = byte_substr(text, start, i);
            }
            push(row, field);
            if i >= n {
                row_done = true;
            } else {
                let t = byte_at(text, i);
                if t == delim {
                    i = i + 1;
                    if i >= n {
                        push(row, "");
                        row_done = true;
                    }
                } else {
                    if t == 13 {
                        i = i + 1;
                        if byte_at(text, i) == 10 { i = i + 1; }
                    } else {
                        i = i + 1;
                    }
                    row_done = true;
                }
            }
        }
        // skip blank lines
        let blank = false;
        if len(row) == 1 {
            if len(row[0]) == 0 { blank = true; }
        }
        if !blank { push(rows, row); }
    }
    return rows;
}

fn csv_parse(text) { return csv_parse_delim(text, 44); }
fn csv_parse_file(path) { return csv_parse(read_file(path)); }

fn csv_escape(s, delim) {
    let n = len(s);
    let needs = false;
    let i = 0;
    while i < n {
        let c = byte_at(s, i);
        if c == delim || c == 34 || c == 10 || c == 13 { needs = true; break; }
        i = i + 1;
    }
    if !needs { return s; }
    let out = [];
    push(out, 34);
    i = 0;
    while i < n {
        let b = byte_at(s, i);
        push(out, b);
        if b == 34 { push(out, 34); }
        i = i + 1;
    }
    push(out, 34);
    return bytes_to_str(out);
}

// rows: array of arrays. Numbers print with the runtime's str() rules. Lines end with LF.
fn csv_stringify(rows) {
    let nl = chr10();
    let lines = [];
    for row in rows {
        let cells = [];
        for cell in row { push(cells, csv_escape(str(cell), 44)); }
        push(lines, join(cells, ","));
    }
    if len(lines) == 0 { return ""; }
    return join(lines, nl) + nl;
}

fn chr10() { return bytes_to_str([10]); }

fn csv_write_file(path, rows) { return write_file(path, csv_stringify(rows)); }

// First row is the header; returns an array of maps.
fn csv_to_maps(rows) {
    let out = [];
    if len(rows) < 2 { return out; }
    let header = rows[0];
    let r = 1;
    while r < len(rows) {
        let m = {};
        let k = 0;
        while k < len(header) {
            let key = header[k];
            m[key] = rows[r][k];
            k = k + 1;
        }
        push(out, m);
        r = r + 1;
    }
    return out;
}