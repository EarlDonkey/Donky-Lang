import "survival.donk";

// lib/world.donk — 2D block world management.
// The world state is a raw mem_alloc'd byte buffer, not a Donky array.
// Each block is one byte. Block IDs match the C palette.
//
// Agent state lives in a second mem_alloc'd buffer, 40 bytes per agent.
// Layout: x@0, y@4, vx@8, vy@12, hp@16, age@20, task@24,
//         target_x@28, target_y@32, carry@36  (all int32 LE)
// task: 0=wander 1=gather 2=build 3=idle 4=flee 5=dead -1=removed

// ---------------------------------------------------------------------------
// World primitives
// ---------------------------------------------------------------------------

fn world_new(width, height, seed) {
    let nbytes = width * height;
    let ptr = mem_alloc(nbytes);
    if is_null_handle(ptr) { throw "world_new: mem_alloc(" + str(nbytes) + ") failed"; }
    let w = {};
    w["ptr"]    = ptr;
    w["width"]  = width;
    w["height"] = height;
    w["seed"]   = seed;
    w["tick"]   = 0;
    return w;
}

fn world_generate(world) {
    let chunk = 128;
    let x = 0;
    while x < world["width"] {
        let y = 0;
        while y < world["height"] {
            world_gen(world["ptr"], world["width"], world["height"],
                      world["seed"], x, y);
            y = y + chunk;
        }
        x = x + chunk;
    }
    return world;
}

fn world_block(world, x, y) {
    if x < 0 || x >= world["width"] || y < 0 || y >= world["height"] { return 0; }
    return ffi_peek(world["ptr"] + y * world["width"] + x, 1);
}

fn world_set_block(world, x, y, id) {
    return world_set(world["ptr"], world["width"], world["height"], x, y, id);
}

// ---------------------------------------------------------------------------
// Agent field readers (int32 LE at fixed offsets in the agent buffer)
// ---------------------------------------------------------------------------

// ffi_peek(ptr, 4) returns an UNSIGNED 32-bit value, so a removed agent's task (-1) would read as
// 4294967295. These readers convert to a signed int32, matching the layout comment above.
fn agent_i32(world, i, off) {
    let v = ffi_peek(world["agents_ptr"] + i * 40 + off, 4);
    if v >= 2147483648 { v = v - 4294967296; }
    return v;
}

fn agent_x(world, i)    { return agent_i32(world, i, 0); }
fn agent_y(world, i)    { return agent_i32(world, i, 4); }
fn agent_task(world, i) { return agent_i32(world, i, 24); }

// ---------------------------------------------------------------------------
// Agent allocation + placement
// ---------------------------------------------------------------------------

// Row of the first non-air cell in column x (the top of the terrain, water included), or -1 if the
// column is empty air all the way down.
fn world_top_y(world, x) {
    let y = 0;
    while y < world["height"] {
        if world_block(world, x, y) != 0 { return y; }
        y = y + 1;
    }
    return -1;
}

// x itself if the top of its column is dry land (not water); otherwise the next dry column to the
// right, wrapping around. Falls back to x if the whole world is water.
fn world_dry_column(world, x) {
    let w = world["width"];
    let cx = x;
    let tries = 0;
    while tries < w {
        let ty = world_top_y(world, cx);
        if ty >= 0 && world_block(world, cx, ty) != 4 { return cx; }
        cx = cx + 1;
        if cx >= w { cx = 0; }
        tries = tries + 1;
    }
    return x;
}

// Allocate `count` agents and stand them on the terrain, at rest.
// Agents are spread evenly across the width (with a small deterministic jitter), moved off any
// lake onto the nearest dry column, and snapped onto the surface by agents_place before this
// function returns, so the very first tick finds every agent standing on solid ground.
// The world must already be generated.
fn agents_init(world, count) {
    let ptr = agents_new(count);
    if is_null_handle(ptr) { throw "agents_init: agents_new(" + str(count) + ") failed"; }
    world["agents_ptr"] = ptr;
    world["agents_n"]   = count;

    let w = world["width"];
    let spacing = floor(w / count);
    let i = 0;
    while i < count {
        let x = floor((i * 2 + 1) * w / (count * 2));
        if spacing > 1 { x = x + (i * 7919) % spacing - floor(spacing / 2); }
        if x < 0 { x = 0; }
        if x >= w { x = w - 1; }
        x = world_dry_column(world, x);
        ffi_poke(ptr_add(ptr, i * 40 + 0), 4, x);
        ffi_poke(ptr_add(ptr, i * 40 + 4), 4, 0);
        ffi_poke(ptr_add(ptr, i * 40 + 16), 4, 100); // hp
        ffi_poke(ptr_add(ptr, i * 40 + 24), 4, 0);   // task = wander
        i = i + 1;
    }
    agents_place(world);                     // snap onto the surface, vx = vy = 0
    return world;
}

// Place every agent on the surface of `world` (column scan from the top down
// to the first solid cell, agent goes one cell above it). Returns the number
// of agents whose (x, y) changed.
fn agents_place(world) {
    if world["agents_ptr"] == null { return 0; }
    return agents_place_on_surface(world["agents_ptr"], world["agents_n"],
                                   world["ptr"], world["width"], world["height"]);
}

// ---------------------------------------------------------------------------
// Survival brain: the agents' decisions come from the MLP in lib/survival.donk
// ---------------------------------------------------------------------------

// Scan window for the nearest gatherable block, in cells either side of the agent.
fn brain_radius() { return 5; }

// Blocks an agent can pick up: dirt (1) and sand (5), the same set agents_tick gathers.
fn block_gatherable(b) {
    if b == 1 || b == 5 { return true; }
    return false;
}

fn brain_clamp01(v) {
    if v < 0 { return 0.0; }
    if v > 1 { return 1.0; }
    return v;
}

// The 6-value state vector the policy sees. It matches data/survival.csv (gen_survival.py) exactly:
//   0 hp            hp / 100, clamped to 0..1
//   1 age_norm      age / 1000, clamped to 0..1
//   2 is_carrying   1 if it holds a block, else 0
//   3 has_ground    1 if the cell below its feet is solid (not air, not water), else 0
//   4 dx, 5 dy      integer offset (other.x - x, other.y - y) to the NEAREST OTHER live agent within
//                   4 cells in both axes (-4..4); (0, 0) when there is none. +dx is right, +dy is down.
// Other agents count only while alive: dead bodies (task 5), removed slots (-1) and hp <= 0 are ignored.
fn agent_state_vec(world, i) {
    let x = agent_x(world, i);
    let y = agent_y(world, i);
    let v = [];
    push(v, brain_clamp01(agent_i32(world, i, 16) / 100.0));
    push(v, brain_clamp01(agent_i32(world, i, 20) / 1000.0));
    if agent_i32(world, i, 36) != 0 { push(v, 1.0); } else { push(v, 0.0); }

    let below = 2;
    if y + 1 < world["height"] { below = world_block(world, x, y + 1); }
    if below != 0 && below != 4 { push(v, 1.0); } else { push(v, 0.0); }

    let best_d = 1000000;
    let best_dx = 0;
    let best_dy = 0;
    let n = world["agents_n"];
    let j = 0;
    while j < n {
        if j != i {
            let t = agent_task(world, j);
            if t >= 0 && t != 5 && agent_i32(world, j, 16) > 0 {
                let dx = agent_x(world, j) - x;
                let dy = agent_y(world, j) - y;
                if dx >= -4 && dx <= 4 && dy >= -4 && dy <= 4 {
                    let d = dx * dx + dy * dy;
                    if d < best_d {
                        best_d = d;
                        best_dx = dx;
                        best_dy = dy;
                    }
                }
            }
        }
        j = j + 1;
    }
    push(v, best_dx * 1.0);
    push(v, best_dy * 1.0);
    return v;
}

// Turn the brain on: load the 720-byte weight file and let the model choose every live agent's task
// after each tick. Throws if the file is missing or the wrong size (nothing is switched on then).
fn agents_use_brain(world, path) {
    survival_load(path);
    world["brain"] = 1;
    return world;
}

fn agents_brain_off(world) {
    world["brain"] = 0;
    return world;
}

// Ask the model for every live agent's next task and write it into the agent buffer. agents_tick's C
// code then runs that task (wander / gather / idle / flee) exactly as before. Dead bodies, removed
// slots and agents with hp <= 0 are left alone. Returns how many agents changed task.
fn agents_decide(world) {
    if world["brain"] != 1 { return 0; }
    if world["agents_ptr"] == null { return 0; }
    let ptr = world["agents_ptr"];
    let n = world["agents_n"];
    let changed = 0;
    let i = 0;
    while i < n {
        let t = agent_task(world, i);
        if t >= 0 && t != 5 && agent_i32(world, i, 16) > 0 {
            let action = survival_action(agent_state_vec(world, i));
            let nt = survival_task_for_action(action);
            if nt != t {
                ffi_poke(ptr + i * 40 + 24, 4, nt);
                changed = changed + 1;
            }
        }
        i = i + 1;
    }
    return changed;
}

// Count of agents per task: {"wander": n, "gather": n, "build": n, "idle": n, "flee": n, "dead": n}.
fn agents_task_counts(world) {
    let c = {};
    c["wander"] = 0; c["gather"] = 0; c["build"] = 0; c["idle"] = 0; c["flee"] = 0; c["dead"] = 0;
    if world["agents_ptr"] == null { return c; }
    let i = 0;
    while i < world["agents_n"] {
        let t = agent_task(world, i);
        if t == 0 { c["wander"] = c["wander"] + 1; }
        if t == 1 { c["gather"] = c["gather"] + 1; }
        if t == 2 { c["build"]  = c["build"]  + 1; }
        if t == 3 { c["idle"]   = c["idle"]   + 1; }
        if t == 4 { c["flee"]   = c["flee"]   + 1; }
        if t == 5 { c["dead"]   = c["dead"]   + 1; }
        i = i + 1;
    }
    return c;
}

// ---------------------------------------------------------------------------
// Tick + render: world physics + agent tick, world mesh + agent render
// ---------------------------------------------------------------------------

// Advance world physics and agents by one tick. Returns a map:
//   physics_changed   cells the physics pass changed (0 on odd ticks: physics runs on even frames)
//   agents_moved      agents whose position changed this tick
//   tick              the tick number just completed
// With the brain on (agents_use_brain), the survival model then sets every live agent's task.
// The two counts are different units, so they are reported separately.
fn world_tick(world) {
    world["tick"] = world["tick"] + 1;
    let changed = world_physics(world["ptr"], world["width"], world["height"], world["tick"]);
    let moved = 0;
    if world["agents_ptr"] != null {
        moved = agents_tick(world["agents_ptr"], world["agents_n"],
                            world["ptr"], world["width"], world["height"], world["tick"]);
    }
    // The model picks each agent's NEXT task at the end of the tick, so the frame rendered after
    // this tick shows the task the agent will carry out on the following one (agents_tick may flip
    // idle -> wander on its own, and deciding afterwards puts the model's choice back).
    if world["brain"] == 1 { agents_decide(world); }
    let r = {};
    r["physics_changed"] = changed;
    r["agents_moved"]    = moved;
    r["tick"]            = world["tick"];
    return r;
}

// Render world, then agents on top. Returns view_ptr.
fn world_render(world, cam_x, cam_y, view_w, view_h, view_ptr) {
    world_mesh(world["ptr"], world["width"], world["height"],
               cam_x, cam_y, view_w, view_h, view_ptr);
    if world["agents_ptr"] != null {
        agents_render(world["agents_ptr"], world["agents_n"],
                      view_ptr, view_w, view_h, cam_x, cam_y);
    }
    return view_ptr;
}

// ---------------------------------------------------------------------------
// Agent queries / commands
// ---------------------------------------------------------------------------

fn agents_alive(world) {
    if world["agents_ptr"] == null { return 0; }
    return agents_count_alive(world["agents_ptr"], world["agents_n"]);
}

fn agent_kill(world, index) {
    if world["agents_ptr"] == null { return 0; }
    return agents_kill(world["agents_ptr"], index, world["agents_n"]);
}

// Smite every live agent whose body centre is within `radius` cells of (px, py).
// An agent's position is its FEET cell and the sprite is ~7 cells tall, so the centre is taken
// 3 cells above it. Dead bodies and removed slots are left alone. agents_kill only sets hp = 0:
// the next tick turns the agent into a body (task 5), and DEAD_TICKS (15) ticks after that the
// slot is removed. Returns how many agents were smitten.
fn agents_smite(world, px, py, radius) {
    if world["agents_ptr"] == null { return 0; }
    let killed = 0;
    let r2 = radius * radius;
    let n = world["agents_n"];
    let j = 0;
    while j < n {
        let t = agent_task(world, j);
        if t >= 0 && t < 5 {
            let dx = agent_x(world, j) - px;
            let dy = (agent_y(world, j) - 3) - py;
            if dx * dx + dy * dy <= r2 {
                killed = killed + agent_kill(world, j);
            }
        }
        j = j + 1;
    }
    return killed;
}
