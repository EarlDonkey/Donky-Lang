import "lib/world.donk";

print("Creating 10x10 world...");
let world = world_new(10, 10, 42);

// Fill with air
let x = 0;
while x < 10 {
    let y = 0;
    while y < 10 {
        world_set_block(world, x, y, 0); // 0 = AIR
        y = y + 1;
    }
    x = x + 1;
}

print("Placing sand at (5, 0)...");
world_set_block(world, 5, 0, 5); // 5 = SAND

print("Ticking 10 times...");
let i = 0;
while i < 10 {
    let changed = world_tick(world);
    print("  tick " + str(i) + ": " + str(changed) + " cells changed");
    i = i + 1;
}

print("Where is the sand now?");
let found = false;
x = 0;
while x < 10 {
    let y = 0;
    while y < 10 {
        if world_block(world, x, y) == 5 {
            print("  Found sand at (" + str(x) + ", " + str(y) + ")");
            found = true;
        }
        y = y + 1;
    }
    x = x + 1;
}

if !found { print("  ERROR: Sand disappeared!"); }